<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<PackageId>DutySpeed</PackageId>
		<Version>1.7.5</Version>
		<AssemblyVersion>1.7.5</AssemblyVersion>
		<FileVersion>1.7.5</FileVersion>
		<InformationalVersion>1.7.5</InformationalVersion>
		<DalamudPluginClass>DutySpeed.Plugin</DalamudPluginClass>
		<GenerateDalamudManifest>true</GenerateDalamudManifest>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="DutySpeed.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>