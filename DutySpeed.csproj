<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<PackageId>DutySpeed</PackageId>
		<Version>1.3.4</Version>
		<AssemblyVersion>1.3.4</AssemblyVersion>
		<FileVersion>1.3.4</FileVersion>

		<DalamudPluginClass>DutySpeed.Plugin</DalamudPluginClass>
		<GenerateDalamudManifest>true</GenerateDalamudManifest>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="DutySpeed.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="DalamudPackager" Version="15.0.0" />
	</ItemGroup>
</Project>