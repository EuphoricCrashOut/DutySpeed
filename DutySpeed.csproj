<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<PackageId>DutySpeed</PackageId>
		<Version>1.3.4</Version>
		<AssemblyVersion>1.3.4</AssemblyVersion>
		<FileVersion>1.3.4</FileVersion>
		<DalamudPluginClass>DutySpeed.Plugin</DalamudPluginClass>
		<GenerateDalamudManifest>true</GenerateDalamudManifest>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="DutySpeed.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- Force compiler to use local dev hooks to match game runtime -->
	<ItemGroup>
		<Reference Include="Dalamud">
			<HintPath>$(AppData)\XIVLauncher\addon\Hooks\dev\Dalamud.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DalamudPackager" Version="15.0.0" />
		<PackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.2" />
	</ItemGroup>
</Project>